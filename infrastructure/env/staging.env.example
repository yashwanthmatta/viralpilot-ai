# Set these as secret env vars on the host. Never commit real values.
APP_ENV=staging
# DATABASE_URL and REDIS_URL are injected by the host (Render blueprint).
DATABASE_URL=
REDIS_URL=
WEB_ORIGIN=https://<staging-dashboard-domain>
# python scripts/hash_password.py  -> paste the hash here
ADMIN_PASSWORD_HASH=
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=
DAILY_LIMIT_USD=1
MONTHLY_LIMIT_USD=60
MAX_VIDEOS_PER_DAY=3
MEDIA_DIR=/data/media
