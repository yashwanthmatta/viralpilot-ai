# Set these as secret env vars on the host. Never commit real values.
APP_ENV=production
# DATABASE_URL and REDIS_URL are injected by the host (Render blueprint).
DATABASE_URL=
REDIS_URL=
WEB_ORIGIN=https://<production-dashboard-domain>
# python scripts/hash_password.py  -> paste the hash here
ADMIN_PASSWORD_HASH=
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=
DAILY_LIMIT_USD=3
MONTHLY_LIMIT_USD=90
TOTAL_LIMIT_USD=100
PER_VIDEO_LIMIT_USD=0.50
MAX_VIDEOS_PER_DAY=3
MAX_VIDEOS_CEILING=5
# Paid campaign discovery (optional; leave empty to use manual entry only)
# Whop OAuth user token with bounty:basic:read and bounty:submission:create
WHOP_ACCESS_TOKEN=
WHOP_API_VERSION_DATE=
# ISO country you are paid in, used for campaign geo eligibility (e.g. US, IN)
OPERATOR_COUNTRY=
# Comma-separated https URLs of authorized campaign feeds (docs/campaign-feed.md)
CAMPAIGN_FEED_URLS=
MAX_ACTIVE_CAMPAIGNS=3
MEDIA_DIR=/data/media
